# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# --- The data itself ---
# Exports are reproducible from NinjaTrader and instrument-specific, so as a
# rule they stay out. The exception is data/, which carries one small export so
# the deployed app has something to open before anyone uploads anything.
*-bars.csv
*-pivots.csv
!data/*-bars.csv
!data/*-pivots.csv

# --- Output ---
segments-*.png
